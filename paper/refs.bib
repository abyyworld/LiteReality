  url          = {https://github.com/Hubs-Foundation/hubs},
  lastaccessed = {November 13, 2026}
}

% Crossref 10.1109/C5.2003.1222325. The founding Croquet paper (replicated computation with
% TeaTime). Note for the draft: Croquet does not simulate "on each client separately"; every
% client runs the SAME deterministic computation, kept in lockstep by a reflector that orders
% messages. It is client-side, but replicated rather than independent.
@inproceedings{croquet,
  author    = {Smith, David A. and Kay, Alan and Raab, Andreas and Reed, David P.},
  title     = {Croquet -- A Collaboration System Architecture},
  booktitle = {Proceedings of the First Conference on Creating, Connecting and Collaborating Through Computing (C5 2003)},
  year      = {2003},
  pages     = {2--9},
  publisher = {IEEE},
  address   = {Kyoto, Japan},
  doi       = {10.1109/C5.2003.1222325}
}

